<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6578810">
  <PropertyGroup>
    <StartupCommand>npm.cmd run dev:weapp</StartupCommand>
    <BuildCommand>npm.cmd run build:weapp</BuildCommand>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
