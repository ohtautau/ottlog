ohtautau.com {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
    # Next serves its public images first and rewrites missing upload paths to
    # the internal API. Sending all /images directly to API hides site artwork.
    @api path /api/* /health /health/ready
    handle @api {
        reverse_proxy api:8080
    }
    handle /feed.xml {
        rewrite * /api/feed
        reverse_proxy api:8080
    }
    handle {
        reverse_proxy web:3000
    }
    log
}
