# Configure these in the .NET API's secret/environment settings, not the browser.
# Leave Sqlite enabled until old PersonalToolStates have been migrated and checked.
PersonalTools__Provider=Sqlite
Supabase__Url=https://YOUR_PROJECT.supabase.co
Supabase__SecretKey=sb_secret_REPLACE_IN_SERVER_SECRET_SETTINGS
# Existing API still needs persistent Data__Directory for accounts and session keys.
Site__Url=https://ohtautau.com
