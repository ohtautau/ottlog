{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ottlog Web",
      "configurations": ["Next.js", "Blog (Edge)"]
    },
    {
      "name": "Next.js",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": ["dev", "--port", "3000"],
      "autoAttachChildProcesses": true
    },
    {
      "name": "Blog (Edge)",
      "type": "edge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
