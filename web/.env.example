# Server-side API address. Restart dev server after changes; rebuild for production.
API_BASE_URL=http://127.0.0.1:5229
# Vercel: set API_BASE_URL to the independently hosted HTTPS API origin.
# Example only: https://api.ohtautau.com (must be provisioned before using it).
# Never point this to the Vercel frontend's own origin: that creates a proxy loop.
# Supabase secret is configured ONLY in the .NET API, never NEXT_PUBLIC_*.
